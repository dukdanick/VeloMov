// Windows resources: program icon, version info and the manifest (DPI awareness, UTF-8).
#include <winver.h>
#include "version.h"
1 ICON "velomov.ico"
1 24 "velomov.exe.manifest"
VS_VERSION_INFO VERSIONINFO
FILEVERSION VER_MAJOR,VER_MINOR,VER_PATCH,0
PRODUCTVERSION VER_MAJOR,VER_MINOR,VER_PATCH,0
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "VeloMov"
      VALUE "FileDescription", "VeloMov video editor"
      VALUE "FileVersion", VER_STRING
      VALUE "ProductName", "VeloMov"
      VALUE "ProductVersion", VER_STRING
      VALUE "LegalCopyright", "GPL-3.0-or-later"
      VALUE "OriginalFilename", "velomov.exe"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
